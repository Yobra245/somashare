# ============================================================
# SomaShare environment configuration
# Copy to .env and fill in. NEVER commit your real .env.
# ============================================================

# --- Database -------------------------------------------------
# PRODUCTION (Vercel): Postgres — Neon, Supabase or Vercel Postgres.
#   DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
#
# LOCAL DEV (sandbox): SQLite — no server needed.
DATABASE_URL="file:./db/custom.db"
# Which Prisma schema matches your DATABASE_URL:
#   local dev  → prisma/schema.dev.prisma (SQLite)
#   production → leave unset (prisma/schema.prisma, PostgreSQL)
PRISMA_SCHEMA=prisma/schema.dev.prisma

# --- Sessions (REQUIRED in production) ------------------------
# Signs session cookies. Generate a fresh one for every deployment:
#   openssl rand -hex 32
# In production a missing/short secret prevents the app from booting.
SESSION_SECRET=generate-me-with-openssl-rand-hex-32

# --- Google OAuth (sign-in + per-student Drive storage) -------
# 1. console.cloud.google.com → new project
# 2. Enable "Google Drive API"
# 3. OAuth consent screen → External → add scope drive.file
#    (see README for the testing/verification caveats)
# 4. Credentials → OAuth client ID → Web application
#    Authorized redirect URI: https://YOUR-DOMAIN/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Public URL of this deployment — used to build the OAuth redirect URI.
APP_URL=http://localhost:3000

# --- Admins ---------------------------------------------------
# Comma-separated emails that see the moderation queue + mailing list.
ADMIN_EMAILS=you@ku.ac.ke

# --- Email (optional — mailing list) --------------------------
# Set RESEND_API_KEY to send welcome notes + broadcasts for real.
# Without it, emails are logged to the console and the admin CSV
# export keeps the list usable from day one.
RESEND_API_KEY=
MAIL_FROM="SomaShare <onboarding@resend.dev>"

# --- Optional -------------------------------------------------
# Override where the sandbox provider stores files (default ./storage)
# SOMA_STORAGE_DIR=./storage
