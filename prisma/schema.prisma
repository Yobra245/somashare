// SomaShare — student-powered learning vault
// PRODUCTION schema (PostgreSQL — Neon / Supabase / Vercel Postgres).
//
// Local sandbox development uses prisma/schema.dev.prisma (SQLite) —
// select it with PRISMA_SCHEMA=prisma/schema.dev.prisma (see .env.example).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String   @id @default(cuid())
  email             String   @unique // must end with @ku.ac.ke (enforced at signup/OAuth callback)
  name              String
  passwordHash      String? // scrypt hash (email+password accounts); null for Google-only accounts
  department        String   @default("Engineering")
  yearOfStudy       String   @default("Year 3")
  driveConnected    Boolean  @default(false)
  driveEmail        String? // the Google account connected for BYO Drive storage
  driveRefreshToken String? // AES-256-GCM encrypted OAuth refresh token (drive.file scope)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  resources Resource[]
  downloads Download[]
}

// Mailing list — students who sign up to hear about launches and updates
model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  source    String   @default("join-page") // join-page | import | seed
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Unit {
  id         String   @id @default(cuid())
  code       String   @unique // e.g. "EET 300"
  title      String // e.g. "Electrical Machines I"
  department String // e.g. "Engineering Department"
  shortLabel String // e.g. "EET Elec" — chip label on Home
  createdAt  DateTime @default(now())

  resources Resource[]
}

model Resource {
  id            String   @id @default(cuid())
  title         String
  unitId        String
  unit          Unit     @relation(fields: [unitId], references: [id])
  type          String // LECTURE_NOTES | PAST_PAPER | REVISION_SLIDES | ASSIGNMENT
  academicYear  String // "Year 1".."Year 5"
  examYear      Int // calendar year of the paper e.g. 2024
  semester      Int // 1 | 2
  uploaderName  String
  uploaderId    String?
  uploader      User?    @relation(fields: [uploaderId], references: [id])
  fileName      String
  fileSize      Int // bytes
  mimeType      String
  driveFileId   String? // Google Drive file id (or sandbox-simulated id)
  webViewLink   String? // Drive viewer link
  verified      Boolean  @default(false) // reviewed by a moderator/admin
  downloadCount Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  downloadEvents Download[]

  @@index([unitId])
  @@index([examYear, semester])
  @@index([uploaderId])
}

model Download {
  id         String   @id @default(cuid())
  resourceId String
  resource   Resource @relation(fields: [resourceId], references: [id])
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  createdAt  DateTime @default(now())

  @@index([resourceId])
}
